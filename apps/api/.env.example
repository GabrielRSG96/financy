# Conexão com o banco de dados (SQLite)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT — use um valor longo e aleatório em produção
JWT_SECRET=

# Tempo de expiração do token (ex.: 15m, 24h, 7d)
JWT_EXPIRES_IN=7d

# Porta em que a API sobe
PORT=4000

# Origens permitidas pelo CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
