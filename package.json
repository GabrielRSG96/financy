{
  "name": "financy",
  "version": "1.0.0",
  "private": true,
  "description": "Financy - aplicação fullstack de gerenciamento de finanças",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "test": "pnpm --filter \"./apps/*\" test",
    "typecheck": "pnpm --filter \"./apps/*\" typecheck",
    "lint": "pnpm --filter \"./apps/*\" lint",
    "setup": "pnpm install && pnpm --filter api db:setup"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
